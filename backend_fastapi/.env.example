# ==============================================================
# FastAPI Production Environment Configuration Template
# ==============================================================

# 1. AI Model Configuration
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# 2. Database Configuration (Supabase PostgreSQL Connection String)
DATABASE_URL=postgresql://postgres.your_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# 3. Supabase File Storage Configuration (Storage & S3 API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_BUCKET=medical-reports

# Supabase S3-Compatible Storage Keys
SUPABASE_S3_ENDPOINT=https://your-project-id.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=your_s3_access_key_id_here
SUPABASE_S3_SECRET_ACCESS_KEY=your_s3_secret_access_key_here

# 4. Authentication & Security
JWT_SECRET=generate_a_secure_random_jwt_secret_key_here
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=SuperSecretPassword123!
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# 5. SMTP Email Configuration (Optional)
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
