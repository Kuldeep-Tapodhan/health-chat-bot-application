# ==========================================
# Next.js 16 Frontend Environment Variables
# ==========================================

# Render FastAPI Backend Public URL (HTTPS)
# Example: https://health-chatbot-backend.onrender.com
NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com

# Google Maps API Key (For Hospital Finder feature)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
